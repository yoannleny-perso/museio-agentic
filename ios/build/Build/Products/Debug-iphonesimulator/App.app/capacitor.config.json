{
	"appId": "com.audaciangroup.museio",
	"appName": "Museio",
	"webDir": "dist",
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"splashFullScreen": false,
			"splashImmersive": false,
			"androidScaleType": "CENTER_CROP",
			"backgroundColor": "#ffff0000"
		},
		"App": {
			"deepLinkingScheme": "museio",
			"deepLinkingCustomScheme": "museio"
		},
		"CapacitorHttp": {
			"enabled": true
		},
		"Keyboard": {
			"resize": "ionic",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"ios": {
		"webContentsDebuggingEnabled": true,
		"scheme": "museio"
	},
	"server": {
		"allowNavigation": [
			"*.stripe.com",
			"https://*.stripe.com"
		]
	},
	"packageClassList": [
		"FCMPlugin",
		"AppPlugin",
		"CAPBrowserPlugin",
		"KeyboardPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"SafeAreaPlugin"
	]
}
