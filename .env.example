VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Optional for local Supabase CLI or function work
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_PASSWORD="your-project-db-password"
SUPABASE_DB_PASSWORD="your-project-db-password"
APP_URL="https://app.museioapp.com"
PUBLIC_APP_URL="https://museioapp.com"
SITE_URL="https://museioapp.com"
ALLOWED_WEB_ORIGINS="https://museioapp.com,https://www.museioapp.com,https://app.museioapp.com"

# Optional: public booking abuse protection
VITE_TURNSTILE_SITE_KEY="your-cloudflare-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-cloudflare-turnstile-secret-key"
BOOKING_REQUEST_RATE_LIMIT_SALT="a-long-random-secret-used-for-hashing-booking-attempts"
BOOKING_RESPONSE_SECRET="a-long-random-secret-for-booking-response-links"

# Email delivery
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# Stripe payments and Connect
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxx"
STRIPE_CLIENT_ID="ca_xxxxxxxxxxxxxxxxx"

# Push delivery (required only if mobile push is enabled in production)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# Optional: production observability (client-side monitoring and sourcemaps)
VITE_SENTRY_DSN="https://public-key@example.ingest.sentry.io/project-id"
VITE_SENTRY_ENVIRONMENT="development"
VITE_SENTRY_RELEASE="local-dev"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.05"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
SENTRY_RELEASE="your-sentry-release-name"
OBSERVABILITY_ALERT_WEBHOOK_URL="https://hooks.example.com/services/your-alert-webhook"

# Optional: enable iOS simulator live-reload against the local Vite dev server
# CAPACITOR_LIVE_RELOAD_URL="http://127.0.0.1:8080"

# Automated critical-flow smoke suite
SMOKE_USER_EMAIL="owner-smoke-user@example.com"
SMOKE_USER_PASSWORD="replace-with-a-dedicated-smoke-user-password"
SMOKE_PUBLIC_PORTFOLIO_USER_ID="00000000-0000-0000-0000-000000000000"
SMOKE_BOOKING_CAPTCHA_TOKEN="turnstile-token-generated-for-smoke-runs"
SMOKE_CLIENT_EMAIL="booking-smoke-recipient@example.com"
